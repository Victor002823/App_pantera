# =========================
# CABECERAS DE SEGURIDAD
# =========================
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none';"
</IfModule>

RewriteEngine On

# =========================
# FORZAR HTTPS
# =========================
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# =========================
# INDEX LIMPIO
# =========================
DirectoryIndex index.php

RewriteCond %{THE_REQUEST} \s/+index.php[\s?] [NC]
RewriteRule ^index.php$ / [R=301,L]

# =========================
# REDIRECCIONES A URLS AMIGABLES
# =========================
# panel_control.php -> /panel
RewriteCond %{THE_REQUEST} \s/+view/home/panel_control.php[\s?] [NC]
RewriteRule ^view/home/panel_control.php$ /panel [R=301,L]

# form.html -> /form
RewriteCond %{THE_REQUEST} \s/+view/home/form.html[\s?] [NC]
RewriteRule ^view/home/form.html$ /form [R=301,L]

# =========================
# URLS AMIGABLES
# =========================
RewriteRule ^panel/?$ view/home/panel_control.php [L,QSA]
RewriteRule ^form/?$ view/home/form.html [L,QSA]

# =========================
# NO REESCRIBIR ARCHIVOS REALES
# =========================
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
